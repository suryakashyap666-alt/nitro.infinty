{
  "version": 2,
  "buildCommand": "cd web-client && npm install && npm run build",
  "outputDirectory": "web-client/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}