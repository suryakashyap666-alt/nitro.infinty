rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. BLOCK ALL ACCESS by default everywhere
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. SECURE USER DATA: Users can ONLY read and write their OWN account
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // 3. SECURE CHAT HISTORY: Users can ONLY access their own messages
      match /history/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}